# Copy to .env and fill in. Never commit .env.

# Required
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/knowledge
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Language model (local Ollama by default)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=4096

# Answer safety (defaults shown)
REFUSAL_THRESHOLD=0.1
VALIDATOR_ENABLED=true
VALIDATOR_MAX_RETRIES=2

# Optional planner agent: measured at no gain on the evaluation set, so off by default
PLANNER_ENABLED=false
PLANNER_MAX_SEARCHES=3

# Optional: use a different model for one agent, e.g. VALIDATOR_MODEL=qwen2.5:3b
