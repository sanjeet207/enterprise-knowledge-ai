# Copy to .env and fill in. Never commit .env.

# Required
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/knowledge
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Language model (local Ollama by default)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_NUM_CTX=4096

# Answer safety (defaults shown)
REFUSAL_THRESHOLD=0.1
VALIDATOR_ENABLED=true
VALIDATOR_MAX_RETRIES=2

# Optional planner agent: measured at no gain on the evaluation set, so off by default
PLANNER_ENABLED=false
PLANNER_MAX_SEARCHES=3

# Optional: use a different model for one agent, e.g. VALIDATOR_MODEL=qwen2.5:3b

# Operations and privacy
# CHAT_RATE_PER_MINUTE=20     questions one person may ask per minute
# RETENTION_DAYS=365          scripts/purge_retention.py removes older audit rows and conversations
# METRICS_TOKEN=              set to turn on GET /metrics (Authorization: Bearer <token>)

# Single sign-on (OpenID Connect, e.g. Microsoft Entra ID). Leave empty to use password sign-in only. See docs/SSO.md
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/sso/callback
# PASSWORD_LOGIN_ENABLED=true   set to false to require SSO for everyone
